---
import Base from '../../layouts/Base.astro';
import { loadContent, readingTime, description, socialImage, articleSchema, type Post, type Author } from '../../lib/content';
import { loadImages, imageWithBase, type ImageManifest } from '../../lib/assets';
import { renderBody } from '../../lib/markdoc';
import { formatDate, pathWithBase } from '../../lib/settings';
export async function getStaticPaths() {
  const { posts, authors } = await loadContent();
  const images = await loadImages();
  return posts.map((post, index) => ({ params: { slug: post.slug }, props: { post, authors, images, previous: posts[index - 1], next: posts[index + 1] } }));
}
interface Props { post: Post; authors: Author[]; images: ImageManifest; previous?: Post; next?: Post }
const { post, authors, images, previous, next } = Astro.props;
const author = authors.find(a => a.slug === post.author)!;
const banner = imageWithBase(images[post.bannerImage], import.meta.env.BASE_URL);
const share = imageWithBase(images[socialImage(post)], import.meta.env.BASE_URL).social;
const { html } = renderBody(post.body, images, import.meta.env.BASE_URL);
const canonical = new URL(Astro.url.pathname, Astro.site!).href;
const schema = articleSchema(post, author, canonical, new URL(share, Astro.site!).href);
---
<Base title={post.seoTitle || post.title} description={description(post)} image={new URL(share, Astro.site!).href} article published={post.publishDate} updated={post.updatedDate || post.publishDate} noindex={post.sample}>
  <article class="article-page">
    <div class="article-banner"><img src={banner.src} srcset={banner.srcset} sizes="(max-width: 1020px) calc(100vw - 40px), 980px" width={banner.width} height={banner.height} alt={post.bannerAlt} fetchpriority="high" /></div>
    <header class="article-header reading-column">
      <h1>{post.title}</h1>
      <div class="article-meta">
        <p><time datetime={post.publishDate}>{formatDate(post.publishDate)}</time><span class="reading-time"> · {readingTime(post.body)} min read</span></p>
        <p class="article-byline">Written by {author.name}{author.role && `, ${author.role}`}</p>
        {post.updatedDate && <p>Updated <time datetime={post.updatedDate}>{formatDate(post.updatedDate)}</time></p>}
      </div>
      {post.sample && <p class="sample-notice">Sample article · Not published on the live blog.</p>}
    </header>
    <div class="reading-column article-body"><div class="prose" set:html={html}></div></div>
    <nav class="article-pagination" aria-label="Article navigation">
      {previous ? <a rel="prev" href={pathWithBase(`posts/${previous.slug}/`)} aria-label={`Previous article: ${previous.title}`}>Previous</a> : <span aria-disabled="true">Previous</span>}
      <a class="square-divider" href={pathWithBase('')} aria-label="All articles"></a>
      {next ? <a rel="next" href={pathWithBase(`posts/${next.slug}/`)} aria-label={`Next article: ${next.title}`}>Next</a> : <span aria-disabled="true">Next</span>}
    </nav>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}></script>
</Base>
