---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { pathWithBase } from '../lib/settings';
---
<Base title="Page not found" noindex><section class="container not-found"><span class="section-kicker">404 / A different direction</span><h1>A little off<br />the chart<span class="accent-period">.</span></h1><p>This page may have moved, or the link took a wrong turn.</p><a class="outline-button" href={pathWithBase('')}>Back to the journal <Arrow /></a></section></Base>
