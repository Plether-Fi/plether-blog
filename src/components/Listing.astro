---
import Base from '../layouts/Base.astro';
import PostCard from './PostCard.astro';
import { paginate, type Post, type Author } from '../lib/content';
import { type ImageManifest } from '../lib/assets';
import { site, pathWithBase, collectionPath, type Category } from '../lib/settings';
interface Props { posts: Post[]; authors: Author[]; images: ImageManifest; page?: number; category?: Category }
const { posts, images, page = 1, category } = Astro.props;
const pagination = paginate(posts, page);
const sample = posts.some(post => post.sample);
const title = category ? `${category}${page > 1 ? ` — Page ${page}` : ''}` : page > 1 ? `Blog — Page ${page}` : undefined;
---
<Base title={title} noindex={sample}>
  <section class="container blog-intro">
    <h1>{category ? `${category} perspectives.` : <>A clearer view of the dollar.<br /> Ideas that move us forward.</>}</h1>
    {sample && <p class="sample-notice">Sample collection · Preview only. These articles are excluded from the live blog.</p>}
  </section>
  <section class="container articles-section" aria-labelledby="articles-heading">
    <h2 id="articles-heading" class="sr-only">{category ? `${category} articles` : 'Latest articles'}</h2>
    {pagination.items.length ? <div class="post-grid">{pagination.items.map((post, index) => <PostCard post={post} images={images} eager={index < 3} />)}</div> : <div class="empty-state"><h3>{category ? 'More to come.' : 'Our first articles are on their way.'}</h3><p>{category ? `Our next ${category.toLowerCase()} article will appear here.` : 'Research, product updates, and perspectives from Plether. Follow along for the first edition.'}</p><a class="text-link" href={category ? pathWithBase('') : 'https://x.com/plether_fi'}>{category ? 'Explore all articles' : 'Follow Plether on X'}</a></div>}
    <nav class="category-tabs" aria-label="Filter articles"><a href={pathWithBase('')} aria-current={!category ? 'page' : undefined}>All articles</a>{site.categories.map(item => <><span class="square-divider" aria-hidden="true"></span><a href={pathWithBase(collectionPath(item))} aria-current={category === item ? 'page' : undefined}>{item}</a></>)}<span class="square-divider" aria-hidden="true"></span><a href={pathWithBase('rss.xml')}>RSS</a></nav>
    {pagination.total > 1 && <nav class="pagination" aria-label="Pagination">{page > 1 ? <a rel="prev" href={pathWithBase(collectionPath(category, page - 1))}>Previous</a> : <span aria-disabled="true">Previous</span>}<span class="page-count">Page {page} of {pagination.total}</span>{page < pagination.total ? <a rel="next" href={pathWithBase(collectionPath(category, page + 1))}>Next</a> : <span aria-disabled="true">Next</span>}</nav>}
  </section>
</Base>
