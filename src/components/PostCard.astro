---
import { type Post } from '../lib/content';
import { imageWithBase, type ImageManifest } from '../lib/assets';
import { pathWithBase } from '../lib/settings';
interface Props { post: Post; images: ImageManifest; eager?: boolean }
const { post, images, eager = false } = Astro.props;
const image = imageWithBase(images[post.bannerImage], import.meta.env.BASE_URL);
---
<article class="post-card">
  <a class="post-image" href={pathWithBase(`posts/${post.slug}/`)} tabindex="-1" aria-hidden="true">
    <img src={image.src} srcset={image.srcset} sizes="(max-width: 600px) calc(100vw - 40px), (max-width: 1000px) 45vw, 400px" width={image.width} height={image.height} alt={post.bannerAlt} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" />
  </a>
  <div class="post-card-content">
    <h2><a href={pathWithBase(`posts/${post.slug}/`)}>{post.title}</a></h2>
    <p class="post-excerpt">{post.excerpt}</p>
  </div>
</article>
