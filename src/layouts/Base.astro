---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import uncutFont from '../../static/fonts/UncutSans-Variable.woff2?url';
import { pathWithBase, site } from '../lib/settings';
interface Props { title?: string; description?: string; image?: string; article?: boolean; published?: string; updated?: string; noindex?: boolean }
const footerLinks = [
  { label: 'Docs', href: 'https://docs.plether.com' },
  { label: 'Blog', href: pathWithBase('') },
  { label: 'X', href: 'https://x.com/plether_fi' },
  { label: 'GitHub', href: 'https://github.com/Plether-Fi/plether-core' },
  { label: 'Manifesto', href: 'https://plether.com/manifesto' },
  { label: 'Media Kit', href: 'https://plether.com/media-kit' },
  { label: 'Audit Reports', href: 'https://github.com/Plether-Fi/plether-core/tree/master/audits' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fff5f9" />
    <Seo {...Astro.props} />
    <link rel="preload" href={uncutFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href={pathWithBase('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={pathWithBase('rss.xml')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={pathWithBase('')} aria-label="Plether Blog home"><img src={pathWithBase('brand/plether-dark.svg')} alt="Plether" width="177" height="35" /></a>
        <nav class="main-nav" aria-label="Main navigation">
          <a href="https://x.com/plether_fi" aria-label="Plether on X">X</a>
          <span class="square-divider" aria-hidden="true"></span>
          <a href={pathWithBase('')} aria-current={Astro.url.pathname === pathWithBase('') ? 'page' : undefined}>Blog</a>
          <span class="square-divider" aria-hidden="true"></span>
          <a href="https://docs.plether.com">Docs</a>
          <span class="square-divider" aria-hidden="true"></span>
          <a class="app-link" href="https://app.plether.com">Launch App</a>
        </nav>
      </div>
      <div class="header-rule" aria-hidden="true"><img src={pathWithBase('brand/header-rule.svg')} alt="Header divider" width="2000" height="1" /></div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <a class="footer-brand" href="https://plether.com" aria-label="Plether home"><img src={pathWithBase('brand/plether-light.svg')} alt="Plether" width="1269.34" height="251" loading="lazy" /></a>
        <div class="footer-bottom">
          <span>© Plether {new Date().getUTCFullYear()}</span>
          <nav class="footer-links" aria-label="Footer navigation">{footerLinks.map((link, index) => <>{index > 0 && <span class="square-divider" aria-hidden="true"></span>}<a href={link.href}>{link.label}</a></>)}</nav>
        </div>
      </div>
    </footer>
  </body>
</html>
