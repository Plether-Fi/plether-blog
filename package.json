{
  "name": "plether-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "dev:editor": "node scripts/astro.mjs dev --editor --host 127.0.0.1 --port 4322",
    "build": "node scripts/astro.mjs build",
    "build:editor": "node scripts/astro.mjs build --editor",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "check": "astro check && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run check && npm test && npm run build && node --import tsx scripts/verify-build.ts",
    "verify:fixtures": "node --import tsx scripts/verify-fixtures.ts"
  },
  "overrides": {
    "minimatch": "11.0.5",
    "glob": "14.0.4"
  },
  "dependencies": {
    "@astrojs/netlify": "8.2.12",
    "@astrojs/react": "7.1.5",
    "@fontsource-variable/inter": "5.3.0",
    "@keystatic/astro": "6.0.0",
    "@keystatic/core": "0.6.9",
    "@markdoc/markdoc": "0.5.11",
    "astro": "7.4.8",
    "gray-matter": "4.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
